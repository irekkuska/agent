# GitHub
GITHUB_TOKEN=your_github_pat_here
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# Groq API (free tier — console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Target repository to analyze
# Fill this when your target repo is ready
TARGET_REPO_URL=https://github.com/your-org/your-repo
TARGET_REPO_BRANCH=main

# Infrastructure (docker-compose defaults — do not change)
QDRANT_URL=http://qdrant:6333
OLLAMA_URL=http://ollama:11434
COLLECTION_NAME=code_chunks

# Server
PORT=3000
